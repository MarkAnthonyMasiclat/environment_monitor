{
  "schema_version": 1,
  "topic": "environment/v1/{device_id}/measurements",
  "subscriber_filter": "environment/v1/+/measurements",
  "qos": 0,
  "retain": false,
  "payload": {
    "type": "object",
    "required": ["schema_version", "device_id", "temperature_c", "humidity_percent"],
    "properties": {
      "schema_version": {"type": "integer", "const": 1},
      "device_id": {"type": "string", "minLength": 1},
      "temperature_c": {"type": "number"},
      "humidity_percent": {"type": "number", "minimum": 0, "maximum": 100}
    },
    "additionalProperties": false
  }
}
